{
  "schemaVersion": 1,
  "id": "nbteditor",
  "version": "2.0.4.999",
  "name": "NBT Editor",
  "description": "Lets you edit items, blocks, and entities ingame, store items in a client side chest, open containers in your inventory, and more!",
  "authors": [
    "mega12345mega"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/nbt-editor",
    "issues": "https://github.com/mega12345mega/NBT-Editor/issues",
    "sources": "https://github.com/mega12345mega/NBT-Editor"
  },
  "license": "MIT",
  "icon": "assets/nbteditor/textures/logo.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.luneruniverse.minecraft.mod.nbteditor.NBTEditor"
    ],
    "client": [
      "com.luneruniverse.minecraft.mod.nbteditor.NBTEditorClient"
    ],
    "modmenu": [
      "com.luneruniverse.minecraft.mod.nbteditor.NBTEditorModMenuApi"
    ]
  },
  "mixins": [
    "nbteditor.mixins.json",
    "nbteditor_multiversion.mixins.json",
    "nbteditor_multiversion_commandapi.mixins.json",
    "nbteditor_multiversion_networkingapi.mixins.json"
  ],
  "accessWidener": "nbteditor.accesswidener",
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric": "*",
    "minecraft": ">=1.21.11-",
    "java": ">=21"
  },
  "suggests": {
    "nbt_ac": ">=1.1"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/PzeYTbEZjn",
        "modmenu.wiki": "https://github.com/mega12345mega/NBT-Editor/wiki",
        "modmenu.buymeacoffee": "https://buymeacoffee.com/mega12345mega"
      }
    },
    "loom:injected_interfaces": {
      "net/minecraft/client/gui/components/EditBox": [
        "com/luneruniverse/minecraft/mod/nbteditor/screens/InjectableTickable"
      ],
      "net/minecraft/client/gui/components/events/GuiEventListener": [
        "com/luneruniverse/minecraft/mod/nbteditor/multiversion/MVElementParent"
      ],
      "net/minecraft/network/syncher/SynchedEntityData": [
        "com/luneruniverse/minecraft/mod/nbteditor/misc/ResetableDataTracker"
      ],
      "net/minecraft/network/FriendlyByteBuf": [
        "com/luneruniverse/minecraft/mod/nbteditor/multiversion/MVPacketByteBufParent"
      ],
      "net/minecraft/world/item/ItemStack": [
        "com/luneruniverse/minecraft/mod/nbteditor/multiversion/nbt/manager/IntegratedNBTManager",
        "com/luneruniverse/minecraft/mod/nbteditor/multiversion/nbt/MVItemStackParent"
      ],
      "net/minecraft/network/protocol/game/ServerboundContainerClickPacket": [
        "com/luneruniverse/minecraft/mod/nbteditor/packets/ClickSlotC2SPacketParent"
      ],
      "net/minecraft/nbt/CompoundTag": [
        "com/luneruniverse/minecraft/mod/nbteditor/multiversion/nbt/MVNbtCompoundParent"
      ],
      "net/minecraft/nbt/CollectionTag": [
        "com/luneruniverse/minecraft/mod/nbteditor/multiversion/nbt/MVAbstractNbtListParent"
      ],
      "net/minecraft/nbt/NumericTag": [
        "com/luneruniverse/minecraft/mod/nbteditor/multiversion/nbt/MVAbstractNbtNumberParent"
      ]
    }
  }
}
